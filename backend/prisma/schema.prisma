generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utente {
  id                 Int                  @id @default(autoincrement())
  email              String               @unique
  password_hash      String
  name               String?
  image              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  collezioniTutte    Collezione[]         @relation("UtenteCollezioni")
  carteInCollezioneTutte CartaInCollezione[] @relation("UtenteCarteInCollezione")
  scansioni          Scansione[]

  @@index([email])
}

model Set {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  series      String?
  releaseDate DateTime?
  totalCards  Int?
  symbolImage String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  carte       Carta[]  @relation("SetCarte")

  @@index([name])
}

model Carta {
  id               Int               @id @default(autoincrement())
  tcgplayerId      String?           @unique
  name             String
  setId            Int?
  number           String?
  rarity           String?
  supertype        String?
  types            String[]
  hp               Int?
  artist           String?
  image_url        String?
  image_url_small  String?
  local_image_path String?
  basePrice        Float?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  set              Set?              @relation("SetCarte", fields: [setId], references: [id])
  inCollezioni     CartaInCollezione[] @relation("CartaInCollezioni")
  priceSnapshots   PriceSnapshot[]   @relation("CartaPriceSnapshots")
  imageReferences  ImageReference[]  @relation("CartaImageReferences")

  @@index([setId])
  @@index([name])
  @@index([tcgplayerId])
}

model Collezione {
  id           Int                  @id @default(autoincrement())
  nome         String
  descrizione  String?
  is_public    Boolean              @default(false)
  image_url    String?
  created_at   DateTime             @default(now())
  updated_at   DateTime             @updatedAt
  carte        CartaInCollezione[]  @relation("CollezioneCarte")
  owner_id     Int
  owner        Utente                @relation("UtenteCollezioni", fields: [owner_id], references: [id])

  @@index([owner_id])
}

model CartaInCollezione {
  id               Int        @id @default(autoincrement())
  collection_id    Int
  card_id          Int
  condition        Condition?
  graded_company   GradedCompany?
  graded_grade     Int?
  condition_date   DateTime?
  quantity         Int        @default(1)
  acquired_date    DateTime?
  acquired_price   Float?
  note             String?
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
  scan_id          String?
  collezione       Collezione @relation("CollezioneCarte", fields: [collection_id], references: [id])
  carta            Carta      @relation("CartaInCollezioni", fields: [card_id], references: [id])
  owner_id         Int
  owner            Utente      @relation("UtenteCarteInCollezione", fields: [owner_id], references: [id])

  @@unique([collection_id, card_id])
  @@index([collection_id])
  @@index([card_id])
}

enum Condition {
  NearMint
  LightPlay
  Play
  Moderate
  Heavy
  Damaged
}

enum GradedCompany {
  PSA
  BGS
  CGC
}

model PriceSnapshot {
  id       Int      @id @default(autoincrement())
  cardId   Int
  source   String
  date     DateTime
  low      Float?
  high     Float?
  mid      Float?
  volume   Float?
  createdAt DateTime @default(now())
  carta    Carta    @relation("CartaPriceSnapshots", fields: [cardId], references: [id])

  @@index([cardId])
  @@index([source])
  @@index([date])
}

model ImageReference {
  id             Int      @id @default(autoincrement())
  cardId         Int
  url            String
  thumbnail_url  String?
  feature_vector Json?
  createdAt      DateTime @default(now())
  carta          Carta    @relation("CartaImageReferences", fields: [cardId], references: [id])

  @@index([cardId])
}

model Scansione {
  id             Int             @id @default(autoincrement())
  ocrText         String?
  setName         String?
  cardNumber      String?
  cardName        String?
  confidence      Float?
  status          ScansioneStatus @default(PENDING)
  matchedCardId   Int?
  originalUrl     String?
  mediumUrl       String?
  thumbnailUrl    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  userId          Int
  user            Utente          @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([setName])
  @@index([cardNumber])
  @@index([matchedCardId])
  @@index([userId])
}

enum ScansioneStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}